{
  "name": "@opsydyn/promo",
  "private": true,
  "type": "module",
  "imports": {
    "#example/measurement": "./src/examples/shared/measurement.ts",
    "#example/frame": "./src/examples/shared/frame.ts"
  },
  "scripts": {
    "dev": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && astro dev",
    "build": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && astro build",
    "preview": "astro preview",
    "typecheck": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && astro check",
    "test": "bun test test",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && oxfmt --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@opsydyn/astro-foldkit": "workspace:*",
    "@opsydyn/foldkit-viz": "workspace:*",
    "@stackblitz/sdk": "1.11.0",
    "astro": "7.1.1",
    "effect": "4.0.0",
    "fflate": "0.8.3",
    "foldkit": "0.167.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/topojson-client": "^3.1.5",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
