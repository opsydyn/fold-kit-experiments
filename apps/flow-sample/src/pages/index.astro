---
import Editor from '../editor/app';
import { themePreferenceStorageKey } from '../editor/theme';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Workflow patterns | FoldKit Flow</title>
    <script is:inline define:vars={{ themePreferenceStorageKey }}>
      // Set the shell color before the FoldKit island starts.
      function readStoredTheme() {
        // oxlint-disable-next-line linteffect/no-try-catch -- This inline browser script runs before the Effect runtime loads.
        try {
          return localStorage.getItem(themePreferenceStorageKey);
        } catch {
          return null;
        }
      }
      const saved = readStoredTheme();
      const scheme = saved === 'light' || saved === 'dark'
        ? saved
        : window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.flowInitialColorScheme = scheme;
    </script>
  </head>
  <body>
    <header><div>FoldKit Flow <span> / Sample app</span></div></header>
    <main>
      <h1>Workflow patterns</h1>
      <p>Explore a release workflow or an architecture pattern.</p>
      <p><a href="https://opsydyn.github.io/fold-kit-experiments/flow/api/">API and type contracts</a></p>
      <Editor client:load />
      <noscript>Enable JavaScript to edit the workflow.</noscript>
    </main>
  </body>
</html>

<style is:global>
/* Hallmark | shape: app screen | signature: release workflow canvas */
/* Critique: keep the toolbar and canvas together on narrow screens. */
:root {
  color-scheme: light;
  --paper: #f8f6f1;
  --ink: #232d27;
  --muted: #4b5e53;
  --rule: #b8c4ba;
  --accent: #24543c;
  --panel: #fdfefb;
  --ui-font: system-ui, sans-serif;
}
:root[data-flow-initial-color-scheme='dark']:not(:has([data-flow-workbench-color-scheme])),
:root:has([data-flow-workbench-color-scheme='dark']) {
  color-scheme: dark;
  --paper: #101c19;
  --ink: #e5f3eb;
  --muted: #b4c9be;
  --rule: #486157;
  --accent: #8ee0b9;
  --panel: #21342d;
}
html,
body {
  overflow-x: clip;
}
body {
  margin: 0;
  font-family: var(--ui-font);
  background: var(--paper);
  color: var(--ink);
}
header {
  border-bottom: 1px solid var(--rule);
}
header > div,
main {
  max-width: 75rem;
  margin-inline: auto;
  padding-inline: clamp(1rem, 4%, 3rem);
}
header > div {
  padding-block: 0.85rem;
  font-weight: 650;
}
header span {
  color: var(--muted);
  font-weight: 400;
}
main {
  padding-block: 1.5rem;
}
h1 {
  margin: 0;
  font-size: 1.75rem;
  min-width: 0;
  overflow-wrap: break-word;
}
p {
  color: var(--muted);
}
button,
input {
  font: inherit;
}
a {
  color: var(--accent);
}
.workbench-theme-picker {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  margin-inline-start: 0.5rem;
}
.workbench-theme-picker select {
  font: inherit;
  min-height: 36px;
  padding: 0 12px;
  border: 1px solid var(--rule);
  border-radius: 0.35rem;
  color: var(--ink);
  background: var(--panel);
}
:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 3px;
}
[aria-label='Graph actions'] button {
  border: 1px solid var(--rule);
  border-radius: 0.35rem;
  min-height: 44px;
  color: var(--ink);
  background: var(--panel);
}
[aria-label='Graph actions'] button[aria-pressed='true'] {
  background: var(--accent);
  color: var(--panel);
}

button:active { filter: brightness(.92); }
h1 { text-wrap: balance; }
</style>
