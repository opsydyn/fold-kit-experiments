---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/site-path';
import { barData } from '../../lib/gallery-charts';
import Bars from '../../examples/bars/app';
import ExampleSource from '../../components/ExampleSource.astro';
import dataSource from '../../examples/bars/data.ts?raw';
import modelSource from '../../examples/bars/model.ts?raw';
import messageSource from '../../examples/bars/message.ts?raw';
import updateSource from '../../examples/bars/update.ts?raw';
import viewSource from '../../examples/bars/view.ts?raw';
const sources = [{ name: 'data.ts', content: dataSource },{ name: 'model.ts', content: modelSource },{ name: 'message.ts', content: messageSource },{ name: 'update.ts', content: updateSource },{ name: 'view.ts', content: viewSource }];
---
<Layout title="Grouped and stacked bars — Foldkit Viz">
  <section class="page-intro"><a class="text-link" href={sitePath('/examples/')}>← All examples</a><p class="eyebrow">LEARN BY CHANGING</p><h1>Parts. Groups. Totals.</h1><p>Compare three series, change the composition and turn the axes. Geometry supplies rectangles; your view chooses colours, patterns and gradients.</p></section>
  <Bars client:load noMeta data={barData} />
  <noscript><p>Enable JavaScript to use the controls. <a href={sitePath('/examples/#grouped-bars')}>See the static bar examples.</a></p></noscript>
  <ExampleSource files={sources} />
</Layout>
