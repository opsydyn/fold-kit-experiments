---
import { ClientRouter } from 'astro:transitions';
import Gallery from '../../../../../../../packages/effect-three-samples/src/gallery/main';
import Room from '../../../../../../../packages/effect-three-samples/src/room/main';
import Workshop from '../../../../../../../packages/effect-three-samples/src/workshop/main';
import Bowling from '../../../../../../../packages/effect-three-samples/src/bowling/main';
import '../../../../../../../packages/effect-three-samples/src/styles.css';

export function getStaticPaths() {
  return ['gallery', 'bowling', 'room', 'workshop'].map((sample) => ({ params: { sample } }));
}
const { sample } = Astro.params;
---
<html lang="en">
  <head><title>{sample}</title><ClientRouter /></head>
  <body>
    <main>
      {sample === 'gallery' && <Gallery client:load />}
      {sample === 'bowling' && <Bowling client:load />}
      {sample === 'room' && <Room client:load />}
      {sample === 'workshop' && <Workshop client:load />}
      {sample === 'gallery' && <a href="/three-scenes/bowling/">Bowling</a>}
      <a href="/away/">Away</a>
    </main>
  </body>
</html>
