  },
  "type": "module",
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:promo": "bun run --filter @opsydyn/promo dev",
    "build": "bun run --filter @opsydyn/web build && bun run --filter @opsydyn/promo build && bun run --filter @opsydyn/three-promo build && bun run --filter @opsydyn/zloz-promo build",
    "test": "moon run :test && moon run :integration",
    "test:p0": "bun run ci:p0",
    "test:vitest": "moon run '#foldkit-vitest:prepare-vitest' && vitest",
    "typecheck": "moon run :typecheck",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && bun run --filter '@opsydyn/effect-three*' check && oxfmt --check . && bun tools/check-catalog.ts && bun tools/check-skills.ts",
    "storybook": "bun run --filter @opsydyn/web storybook",
    "check:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types\" oxlint --fix . && bun run --filter '@opsydyn/effect-three*' check",
    "dev:three-promo": "bun run --filter @opsydyn/three-promo dev",
    "dev:zloz-demo": "bun run --filter @opsydyn/zloz-demo dev",
    "dev:polars-summary": "bun run --filter @opsydyn/polars-summary dev",
    "dev:zloz-promo": "bun run --filter @opsydyn/zloz-promo dev",
    "dev:tech-radar": "bun run --filter @opsydyn/tech-radar dev",
    "dev:docs": "bun run --filter @opsydyn/docs dev",
    "relay": "bun packages/effect-three-samples/scripts/relay.ts",
    "scene-mcp": "bun packages/effect-three-samples/scripts/scene-mcp.ts",
    "hooks:install": "moon sync vcs-hooks",
    "ci:p0": "moon run root:p0",
    "ci:check": "moon run :lint root:format root:catalog root:skills :typecheck :test :build :api-check :size-check :schema-check :docs && moon run :integration",
    "ci:effect-three": "moon run effect-three:pack-check effect-three-foldkit:pack-check effect-three-rapier:pack-check effect-three-troika:pack-check effect-three-foldkit:e2e foldkit-dash:e2e",
    "ci:foldkit-zloz": "moon run web:e2e-zloz web:e2e-zloz-native",
    "ci:astro-compat": "moon run astro-foldkit:compat",
    "ci:clean": "bun tools/ci-local.ts --fresh",
    "dev:effect-ui-tools": "effect-ui-devtools",
    "dev:zloz-team": "bun run --filter @opsydyn/zloz-team dev"
  },
  "devDependencies": {
    "@antebudimir/eslint-plugin-vanilla-extract": "^1.17.0",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/ui": "catalog:",
    "@effect/ui-devtools": "catalog:",
    "@effect/ui-kit": "catalog:",
    "@moonrepo/cli": "2.5.4",
    "@opsydyn/effect-three": "catalog:published",
    "@opsydyn/oxlint-effect": "catalog:",
    "@oxlint/plugins": "1.79.0",
    "@typescript-eslint/utils": "^8.63.0",
    "effect": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@effect/ui@https://pkg.pr.new/Effect-TS/ui/@effect/ui@77dcd92": "patches/@effect%2Fui@https%3A%2F%2Fpkg.pr.new%2FEffect-TS%2Fui%2F@effect%2Fui@77dcd92.patch"
  }
}
