---
import * as barStyles from '../../apps/bar/bar.css';
import Layout from '../../layouts/Layout.astro';
import * as layoutStyles from '../../layouts/layout.css';

const samples = [
  {
    href: '/effect-three/playground',
    title: 'Reconciliation playground',
    body: 'Add, move, reorder, repaint and remove keyed cubes that glide into place, and watch exactly which operations each update takes and which GPU resources it holds.',
  },
  {
    href: '/effect-three/sculpture',
    title: 'Sculpture and time travel',
    body: 'Stack blocks, balls and drums by clicking in 3D. The DevTools are in time-travel mode: pick any history row and the scene rewinds with the Model.',
  },
  {
    href: '/effect-three/studio',
    title: 'Studio: lights, materials and drag',
    body: 'Drag five pieces in five material kinds under hemisphere, point and spot lights with soft shadows. Right-click for a new finish; toggle tone mapping and an orthographic camera.',
  },
  {
    href: '/effect-three/city',
    title: 'City: 10,000 instances',
    body: 'Ten thousand buildings in one instanced mesh and one draw call. Hover and click change one instance each, and the scene draws only when something changes.',
  },
  {
    href: '/effect-three/workshop',
    title: 'Workshop: models, textures and clips',
    body: 'A glTF robot and a floor texture load through Commands into AsyncData. Play its clips, click its parts, and unload it all from the GPU.',
  },
  {
    href: '/effect-three/bars',
    title: '3D bar chart',
    body: 'Foldkit Viz scales place the bars; effect-three eases them when the data changes. Hover, pin, isolate a series, and read it all in the data table.',
  },
  {
    href: '/effect-three/shared',
    title: 'Shared resources',
    body: 'Two cubes share one geometry and one material. Repaint, resize, remove one, or unmount the whole scene and its WebGL context.',
  },
];
---

<Layout title="effect-three samples — Astro + FoldKit">
  <h1 class={layoutStyles.heading}>effect-three</h1>
  <p>Declarative Three.js scenes for Foldkit: the scene is plain data derived from the Model.</p>
  {
    samples.map((sample) => (
      <a class={barStyles.card} href={sample.href} style="display:block;margin-bottom:1rem;color:inherit;text-decoration:none">
        <h2>{sample.title}</h2>
        <p>{sample.body}</p>
      </a>
    ))
  }
</Layout>
