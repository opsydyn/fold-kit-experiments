---
import Layout from '../../layouts/Layout.astro';
import {sitePath} from '../../lib/site-path';
import Signals from '../../examples/signals/app';
import {qualityProps} from '../../examples/signals/quality-data';
import ExampleSource from '../../components/ExampleSource.astro';
import data from '../../examples/signals/data.ts?raw';
import quality from '../../examples/signals/quality.ts?raw';
import qualityData from '../../examples/signals/quality-data.ts?raw';
import qualityView from '../../examples/signals/quality-view.ts?raw';
import baseline from '../../examples/signals/baseline.ts?raw';
import comparison from '../../examples/signals/comparison.ts?raw';
import comparisonView from '../../examples/signals/comparison-view.ts?raw';
import events from '../../examples/signals/events.ts?raw';
import eventsData from '../../examples/signals/events-data.ts?raw';
import eventDerive from '../../examples/signals/event-derive.ts?raw';
import eventView from '../../examples/signals/event-view.ts?raw';
import model from '../../examples/signals/model.ts?raw';
import message from '../../examples/signals/message.ts?raw';
import update from '../../examples/signals/update.ts?raw';
import command from '../../examples/signals/command.ts?raw';
import derive from '../../examples/signals/derive.ts?raw';
import input from '../../examples/signals/input.ts?raw';
import view from '../../examples/signals/view.ts?raw';
const sources=[{name:'data.ts',content:data},{name:'quality.ts',content:quality},{name:'quality-data.ts',content:qualityData},{name:'quality-view.ts',content:qualityView},{name:'baseline.ts',content:baseline},{name:'comparison.ts',content:comparison},{name:'comparison-view.ts',content:comparisonView},{name:'events.ts',content:events},{name:'events-data.ts',content:eventsData},{name:'event-derive.ts',content:eventDerive},{name:'event-view.ts',content:eventView},{name:'model.ts',content:model},{name:'message.ts',content:message},{name:'update.ts',content:update},{name:'command.ts',content:command},{name:'derive.ts',content:derive},{name:'input.ts',content:input},{name:'view.ts',content:view}];
---
<Layout title="Signal desk — Foldkit Viz">
<section class="page-intro"><a class="text-link" href={sitePath('/examples/')}>← All examples</a><p class="eyebrow">CONTROLLED EXPLORATION</p><h1>Find the moment.<br/>Follow the signal.</h1><p>Brush a time range. Pan the details. Pin an observation across latency, errors and raw data. Distinguish missing values from zero, inspect supplied intervals, and recognise source freshness. Capture an exact baseline and compare another observation without losing its provenance. Select a recorded event at its exact time without inventing a measurement or a causal link. Pure geometry follows explicit Foldkit state.</p><p class="signal-context">Illustrative static telemetry. Independent Y scales stay fixed as you explore time. This example demonstrates composition, not a production monitoring system.</p></section>
<Signals client:load noMeta {...qualityProps}/>
<noscript><p>Enable JavaScript for inspection and controls. The charts and full raw observation table remain available below.</p></noscript>
<ExampleSource files={sources}/>
</Layout>
