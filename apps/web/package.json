    "@duckdb/duckdb-wasm": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/ui": "catalog:",
    "@nanostores/persistent": "^1.3.4",
    "@opsydyn/astro-effect-ui": "catalog:published",
    "@opsydyn/dataset-explorer": "workspace:*",
    "@opsydyn/effect-three": "catalog:published",
    "@opsydyn/effect-three-rapier": "catalog:published",
    "@opsydyn/effect-three-samples": "workspace:*",
    "@opsydyn/effect-three-troika": "catalog:published",
    "@opsydyn/foldkit-viz": "catalog:published",
    "@opsydyn/foldkit-zloz": "catalog:published",
    "@opsydyn/foldkit-zloz-elk": "catalog:published",
    "@types/topojson-client": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "astro": "catalog:",
    "effect": "catalog:",
    "fast-json-patch": "3.1.1",
    "nanostores": "^1.4.0",
    "three": "catalog:",
    "topojson-client": "catalog:",
    "world-atlas": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
