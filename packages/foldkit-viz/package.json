    "test": "bun run test:unit && bun run test:package",
    "test:unit": "bun test --path-ignore-patterns='**/package-import-smoke.test.ts'",
    "test:package": "bun test ./test/package-import-smoke.test.ts",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && oxfmt --check .",
    "check:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types\" oxlint --fix .",
    "docs": "bun run --filter @opsydyn/effect-three build && typedoc",
    "api:report": "bun ../../tools/api-surface.ts",
    "api:check": "bun ../../tools/api-surface.ts --check",
    "size:check": "bun ../../tools/bundle-budget.ts",
    "size:write": "bun ../../tools/bundle-budget.ts --write",
    "schema:write": "bun ../../tools/plot-schema.ts",
    "schema:check": "bun ../../tools/plot-schema.ts --check"
