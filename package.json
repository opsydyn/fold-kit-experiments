{
  "name": "@opsydyn/astro-foldkit-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "infra/*"
    ],
    "catalog": {
      "@arethetypeswrong/cli": "0.18.5",
      "@astrojs/check": "^0.9.10",
      "@astrojs/cloudflare": "14.4.0",
      "@astrojs/markdown-remark": "7.3.3",
      "@astrojs/starlight": "0.42.6",
      "@dimforge/rapier3d-deterministic-compat": "0.21.0",
      "@effect/platform-browser": "4.1.0",
      "@foldkit/ui": "0.170.0",
      "@foldkit/vite-plugin": "^0.29.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@fontsource/b612": "5.3.0",
      "@fontsource/b612-mono": "5.3.0",
      "@fontsource/inter": "5.3.0",
      "@microsoft/api-extractor": "7.59.4",
      "@opsydyn/oxlint-effect": "2.0.1",
      "@types/bun": "1.4.3",
      "@types/hast": "^3.0.5",
      "@types/node": "^22.0.0",
      "@types/pngjs": "6.0.5",
      "@types/three": "0.186.0",
      "@types/topojson-client": "^3.1.5",
      "@vanilla-extract/css": "^1.21.1",
      "@vanilla-extract/vite-plugin": "^5.2.4",
      "astro": "7.4.0",
      "bun-types": "^1.3.14",
      "effect": "4.1.0",
      "fast-check": "^4.8.0",
      "foldkit": "0.170.0",
      "happy-dom": "^20.10.6",
      "hast-util-to-html": "^9.0.5",
      "oxlint": "1.79.0",
      "oxlint-tsgolint": "7.0.2004",
      "pixelmatch": "8.0.0",
      "playwright": "1.64.1",
      "pngjs": "7.0.0",
      "publint": "0.3.25",
      "satori": "0.60.0",
      "sharp": "0.35.5",
      "three": "0.186.1",
      "topojson-client": "^3.1.0",
      "tsdown": "^0.21.8",
      "typescript": "^6.0.3",
      "vitest": "^5.0.5",
      "vscode-oniguruma": "2.0.1",
      "world-atlas": "^2.0.2",
      "wrangler": "^4.125.0"
    },
    "catalogs": {
      "strict": {
        "oxlint": "1.88.0",
        "typescript": "7.0.2"
      },
      "infra": {
        "@alchemy.run/cloudflare": "2.0.0-beta.84",
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
        "@effect/platform-bun": "4.0.7",
        "@effect/platform-node": "4.0.7",
        "alchemy": "2.0.0-beta.84",
        "effect": "4.0.7"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:promo": "bun run --filter @opsydyn/promo dev",
    "build": "bun run --filter @opsydyn/astro-foldkit build && bun run --filter @opsydyn/web build && bun run --filter @opsydyn/promo build && bun run --filter @opsydyn/three-promo build",
    "test": "bun test ./.github/scripts/format-release-changelogs.test.js && bun run --sequential --filter '*' test",
    "typecheck": "bun run --sequential --filter '*' typecheck",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && bun run --filter '@opsydyn/effect-three*' check && oxfmt --check . && bun tools/check-catalog.ts",
    "storybook": "bun run --filter @opsydyn/web storybook",
    "check:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types\" oxlint --fix . && bun run --filter '@opsydyn/effect-three*' check",
    "dev:three-promo": "bun run --filter @opsydyn/three-promo dev",
    "dev:tech-radar": "bun run --filter @opsydyn/tech-radar dev",
    "dev:docs": "bun run --filter @opsydyn/docs dev",
    "relay": "bun packages/effect-three-samples/scripts/relay.ts"
  },
  "devDependencies": {
    "@antebudimir/eslint-plugin-vanilla-extract": "^1.17.0",
    "@effect/language-service": "^0.86.2",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "^0.15.3",
    "@opsydyn/oxlint-effect": "catalog:",
    "@oxlint/plugins": "1.79.0",
    "@typescript-eslint/utils": "^8.63.0",
    "effect": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "bun@1.4.3"
}
