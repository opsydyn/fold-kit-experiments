---
import PageLayout from '../../layouts/PageLayout.astro';
import FlatRadar from '../../radar/flat/app';
import { radar, radarTitle } from '../../radar/radar';

// Built ahead and served as a static asset; only `/` renders per request.
export const prerender = true;
---

<PageLayout title={`${radarTitle} in 2D`}>
  <h1>{radarTitle}</h1>
  <p><a href="/">The radar in 3D</a></p>
  <FlatRadar client:load dataset={radar} />
</PageLayout>
