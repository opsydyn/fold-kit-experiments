---
import Layout from '../../layouts/Layout.astro';
import SourceCode from '../../components/SourceCode.astro';
import { sitePath } from '../../lib/site-path';
import Bars from '../../examples/bars/app';
import { barData } from '../../examples/bars/data';

const files = import.meta.glob<string>('../../examples/bars/*.ts', {
  query: '?raw', import: 'default', eager: true,
});
const sources = Object.entries(files).map(([path, content]) => ({
  name: path.split('/').at(-1) ?? path, content,
}));
---
<Layout title="Grouped and stacked bars — Foldkit Viz">
  <section class="page-intro">
    <a class="text-link" href={sitePath('/examples/')}>← All examples</a>
    <p class="eyebrow">Bars</p>
    <h1>Monthly activity</h1>
    <p>Four months. Three teams. Parts, groups and totals.</p>
    <p class="small-note">Illustrative data.</p>
  </section>
  <Bars client:load noMeta data={barData} />
  <noscript><p>Interactive controls require JavaScript. <a href={sitePath('/examples/#grouped-bars')}>View the static bar charts.</a></p></noscript>
  <section class="bars-source" aria-labelledby="bars-source-heading">
    <h2 id="bars-source-heading">Source</h2>
    <nav aria-label="Source files">{sources.map(({ name }) => <a href={'#file-' + name}>{name}</a>)}</nav>
    {sources.map(({ name, content }) => <section id={'file-' + name} aria-labelledby={'heading-' + name}>
      <h3 id={'heading-' + name}>{name}</h3>
      <SourceCode code={content} lang="ts" sourceId={name} />
    </section>)}
  </section>
</Layout>
<style>
  .bars-source { min-width: 0; margin-bottom: 64px; }
  .bars-source h2 { font-size: 24px; }
  .bars-source h3 { font-size: 15px; margin: 24px 0 12px; }
  .bars-source nav { display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px; }
  .bars-source section { min-width: 0; }
  .bars-source :global(pre) { max-width: 100%; overflow: auto; padding: 20px; font-size: 12px; line-height: 1.7; border-block: 1px solid var(--border); }
</style>
