---
/*
 * A page that scrolls: the full pages. Each works without JavaScript.
 */
import Meta from '../components/Meta.astro';
import Typefaces from '../components/Typefaces.astro';
import { pageThemeCss } from '../radar/pageTheme';
import { editions, radarIntro, radarTitle } from '../radar/radar';
import { type Category, categoryIds, categoryLabels } from '../radar/three/data';
import {
  defaultTypeface,
  Typeface,
  typefaceLabels,
  typefaceStorage,
} from '../radar/three/typefaces';

interface Props {
  title: string;
  /** What the page is about, for search results and link previews; the radar's by default. */
  description?: string;
  /** The category the page belongs to, marked as current in the site's navigation. */
  section?: Category;
  /** The edition the page shows, marked as current in the footer. */
  edition?: string;
  /** Use the screen's width on big viewports, for a page laid out in columns. */
  wide?: boolean;
}
const { title, description = radarIntro, section, edition, wide = false } = Astro.props;
const documentTitle = title === radarTitle ? title : `${title} · ${radarTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <Meta title={documentTitle} description={description} />
    <style is:inline set:html={pageThemeCss} />
    <Typefaces />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{radarTitle}</a>
      <nav aria-label="Site">
        <a href="/">Radar</a>
        {
          categoryIds.map((id) => (
            <a
              href={`/category/${id}/`}
              aria-current={id === section ? 'page' : undefined}
              style={`--series: var(--category-${id})`}
            >
              <span class="nav-swatch" aria-hidden="true" />
              {categoryLabels[id]}
            </a>
          ))
        }
      </nav>
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Editions">
        <span>Editions:</span>
        {
          editions.map(({ date, label }) => (
            <a href={`/edition/${date}/`} aria-current={date === edition ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
      <label class="type-picker" hidden>
        Type
        <select id="typeface">
          {
            Typeface.literals.map((typeface) => (
              <option value={typeface} selected={typeface === defaultTypeface}>
                {typefaceLabels[typeface]}
              </option>
            ))
          }
        </select>
      </label>
    </footer>
    <script is:inline define:vars={{ known: Typeface.literals, key: typefaceStorage.key }}>
      // The type picker needs a script, so it shows only when one runs. The choice is kept
      // for every page and the 3D radar; the head applied it before the first paint.
      const picker = document.querySelector('.type-picker');
      const select = document.querySelector('#typeface');
      if (picker !== null && select !== null) {
        const shown = document.documentElement.dataset.typeface;
        if (known.includes(shown)) select.value = shown;
        picker.hidden = false;
        select.addEventListener('change', () => {
          if (!known.includes(select.value)) return;
          document.documentElement.dataset.typeface = select.value;
          try {
            localStorage.setItem(key, select.value);
          } catch {
            // Storage refused: the choice holds for this page only.
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Moving between pages cross-fades, and an entry page's name and locator move into place. */
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none;
    }
  }

  .site-header {
    view-transition-name: site-header;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--page);
    color: var(--text);
    font-family: var(--type-text);
    line-height: 1.5;
  }

  /* Names and headings in the display face; readings (rings, counts, dates, labels) in the
     data face, numbers in columns. */
  h1,
  h2,
  h3,
  .site-name {
    font-family: var(--type-display);
    font-weight: var(--type-display-weight);
    letter-spacing: var(--type-display-tracking);
    text-transform: var(--type-display-case);
  }

  .data,
  time,
  table,
  figcaption,
  .site-footer,
  .breadcrumb,
  svg text {
    font-family: var(--type-data);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  .data,
  figcaption,
  .breadcrumb {
    font-size: calc(1em * var(--type-data-scale));
  }

  .type-picker {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: auto;
  }

  .type-picker[hidden] {
    display: none;
  }

  .type-picker select {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.2rem 0.4rem;
    color: var(--text);
    font: inherit;
  }

  a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  main {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  main.wide {
    max-width: 110rem;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.2;
  }

  h2 {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
  }

  .site-header,
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    border-bottom: none;
    color: var(--muted);
  }

  .site-header nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .site-header nav a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .nav-swatch {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--series);
  }

  .site-header nav a[aria-current='page'],
  .site-footer nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    text-decoration-thickness: 2px;
  }

  .site-name {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
  }

  .muted {
    color: var(--muted);
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 0.35rem 0.75rem 0.35rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
</style>
