---
import { sitePath } from '../lib/site-path';
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
---
<a class:list={['brand', { 'brand-footer': footer }]} href={sitePath('/')} aria-label="effect-three home">
  <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
    <path d="M16 2 29 9.5 16 17 3 9.5Z" fill="var(--blue)" />
    <path d="M3 9.5 16 17v14L3 23.5Z" fill="var(--gold)" />
    <path d="M29 9.5 16 17v14l13-7.5Z" fill="var(--coral)" />
  </svg>
  <span>effect-three</span>
</a>
