{
  "name": "@opsydyn/three-promo",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild-packages": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && bun run --filter @opsydyn/effect-three build && bun run --filter @opsydyn/effect-three-foldkit build",
    "dev": "bun run prebuild-packages && astro dev",
    "build": "bun run prebuild-packages && astro build",
    "preview": "astro preview",
    "typecheck": "bun run prebuild-packages && astro check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@opsydyn/astro-foldkit": "workspace:*",
    "@opsydyn/dataset-explorer": "workspace:*",
    "@opsydyn/effect-three": "workspace:*",
    "@opsydyn/effect-three-foldkit": "workspace:*",
    "@opsydyn/effect-three-samples": "workspace:*",
    "astro": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "hast-util-to-html": "catalog:",
    "three": "catalog:",
    "vscode-oniguruma": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@types/hast": "catalog:",
    "bun-types": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
