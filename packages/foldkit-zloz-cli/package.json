{
  "name": "@opsydyn/foldkit-zloz-cli",
  "version": "0.1.0",
  "description": "Effect CLI for Zloz model validation and loss-aware Mermaid export.",
  "keywords": [
    "architecture",
    "cli",
    "foldkit",
    "graph",
    "mermaid",
    "zloz"
  ],
  "homepage": "https://github.com/opsydyn/fold-kit-experiments/tree/main/packages/foldkit-zloz-cli#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/fold-kit-experiments/issues"
  },
  "license": "MIT",
  "author": "Alan P Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/foldkit-zloz-cli"
  },
  "bin": {
    "zloz": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --filter @opsydyn/foldkit-zloz-mermaid build && tsdown",
    "typecheck": "bun run --filter @opsydyn/foldkit-zloz-mermaid build && tsc --noEmit",
    "test": "bun run build && bun test ./test",
    "pack:check": "bun run build && publint && bun ../../tools/pack-zloz.ts foldkit-zloz-cli"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@opsydyn/foldkit-zloz": "workspace:*",
    "@opsydyn/foldkit-zloz-mermaid": "workspace:*",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "publint": "0.3.25",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
