{
  "name": "@opsydyn/web",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && bun run --filter @opsydyn/effect-three build && bun run --filter @opsydyn/effect-three-foldkit build && bun run --filter @opsydyn/effect-three-rapier build",
    "dev": "astro dev --force",
    "build": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && bun run --filter @opsydyn/effect-three build && bun run --filter @opsydyn/effect-three-foldkit build && bun run --filter @opsydyn/effect-three-rapier build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:e2e": "bun run predev && playwright test",
    "test:e2e:smoke": "bun run test:e2e e2e/agent-analysis.smoke.spec.ts",
    "typecheck": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/astro-foldkit build && bun run --filter @opsydyn/effect-three build && bun run --filter @opsydyn/effect-three-foldkit build && bun run --filter @opsydyn/effect-three-rapier build && astro check",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && oxfmt --check .",
    "check:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types\" oxlint --fix .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@astrojs/cloudflare": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@foldkit/vite-plugin": "catalog:",
    "@nanostores/persistent": "^1.3.4",
    "@opsydyn/astro-foldkit": "workspace:*",
    "@opsydyn/dataset-explorer": "workspace:*",
    "@opsydyn/effect-three": "workspace:*",
    "@opsydyn/effect-three-foldkit": "workspace:*",
    "@opsydyn/effect-three-rapier": "workspace:*",
    "@opsydyn/effect-three-samples": "workspace:*",
    "@opsydyn/foldkit-viz": "workspace:*",
    "@types/topojson-client": "catalog:",
    "@vanilla-extract/css": "^1.21.1",
    "astro": "catalog:",
    "effect": "catalog:",
    "fast-json-patch": "3.1.1",
    "foldkit": "catalog:",
    "nanostores": "^1.4.0",
    "three": "catalog:",
    "topojson-client": "catalog:",
    "world-atlas": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@foldkit/devtools": "0.167.0",
    "@foldkit/ui": "0.167.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/html": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@vanilla-extract/vite-plugin": "^5.2.4",
    "happy-dom": "catalog:",
    "storybook": "^10.4.6",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "catalog:"
  }
}
