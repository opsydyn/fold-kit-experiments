{
  "name": "@opsydyn/effect-three",
  "version": "0.6.4",
  "description": "Effect-native declarative Three.js scenes: scoped resources, keyed reconciliation, testable frame loop.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/effect-three"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/.tsbuildinfo",
    "!dist/api-extractor",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "bun": "./src/kernel/index.ts",
      "default": "./dist/kernel/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl/index.d.ts",
      "bun": "./src/webgl/index.ts",
      "default": "./dist/webgl/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu/index.d.ts",
      "bun": "./src/webgpu/index.ts",
      "default": "./dist/webgpu/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "bunx --bun oxlint --config oxlint.strict.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:single-effect": "bun scripts/check-single-effect.ts",
    "check": "bun run lint && bun run check:boundaries && bun run check:single-effect",
    "test": "bun test --pass-with-no-tests ./src ./test --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun scripts/check-coverage.ts coverage/lcov.info",
    "build": "tsc -b && bun build ./src/index.ts ./src/kernel/index.ts ./src/webgl/index.ts ./src/webgpu/index.ts --root ./src --outdir ./dist --target browser --packages external --splitting --sourcemap=linked",
    "scene:diff": "bun scripts/scene-diff.ts",
    "scene:preview": "bun scripts/scene-preview.ts",
    "bench": "bun bench/index.ts",
    "bench:check": "bun bench/index.ts --check",
    "api:report": "api-extractor run --local",
    "api:check": "api-extractor run",
    "pack:check": "bun run build && publint && rm -rf dist/pack && bun pm pack --destination dist/pack && attw dist/pack/*.tgz --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.59.4",
    "@opsydyn/oxlint-effect": "2.0.1",
    "@types/bun": "1.4.3",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "effect": "4.1.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "publint": "0.3.25",
    "three": "0.186.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "three": ">=0.186.0 <0.187.0"
  }
}
