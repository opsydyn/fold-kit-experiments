---
import ExampleSource from '../../components/ExampleSource.astro';
import Sample from '../../examples/workshop/app';
import Layout from '../../layouts/Layout.astro';
import { samplesSource } from '../../lib/links';
import { sitePath } from '../../lib/site-path';
import modelSource from '@opsydyn/effect-three-samples/src/workshop/model.ts?raw';
import commandSource from '@opsydyn/effect-three-samples/src/workshop/command.ts?raw';
import updateSource from '@opsydyn/effect-three-samples/src/workshop/update.ts?raw';
import sceneSource from '@opsydyn/effect-three-samples/src/workshop/scene.ts?raw';
import viewSource from '@opsydyn/effect-three-samples/src/workshop/view.ts?raw';
const sources = [{ name: 'model.ts', content: modelSource }, { name: 'command.ts', content: commandSource }, { name: 'update.ts', content: updateSource }, { name: 'scene.ts', content: sceneSource }, { name: 'view.ts', content: viewSource }];
---
<Layout title="Workshop — effect-three">
  <section class="page-intro"><a class="text-link" href={sitePath('/examples/')}>← All examples</a><p class="eyebrow">MODELS, TEXTURES, CLIPS</p><h1>Load it, play it, let it go.</h1><p>A glTF robot and a floor texture load through Foldkit Commands into AsyncData. Play its clips at any speed, click a part to name it, then unload everything from the GPU and load it again.</p></section>
  <Sample client:load noMeta assetBase={sitePath('/models/')} />
  <noscript><p>This example needs JavaScript and WebGL to render the scene.</p></noscript>
  <section class="closing-callout"><h2>Your objects, our lifetimes.</h2><p>Loaded assets are lent to the scene's resource store, so the description only names them by id: a borrowed node shows the model the moment it arrives, and the floor picks up its texture when it settles. Clips play as a function of scene time. Unloading disposes everything the loader created.</p><a class="text-link" href={samplesSource + '/workshop'}>Explore the example source →</a></section>
  <ExampleSource files={sources} />
</Layout>
