{
  "name": "@opsydyn/foldkit-zloz-elk",
  "version": "0.1.1",
  "description": "Optional ELK layout adapter for Foldkit Zloz.",
  "keywords": [
    "diagram",
    "flow",
    "foldkit",
    "graph",
    "typescript"
  ],
  "homepage": "https://github.com/opsydyn/fold-kit-experiments/tree/main/packages/foldkit-zloz-elk#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/fold-kit-experiments/issues"
  },
  "license": "MIT",
  "author": "Alan P Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/foldkit-zloz-elk"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --filter @opsydyn/foldkit-zloz build && tsdown",
    "typecheck": "bun run --filter @opsydyn/foldkit-zloz build && tsc --noEmit",
    "test": "bun test ./test",
    "pack:check": "bun run build && publint && bun ../../tools/pack-zloz.ts foldkit-zloz-elk"
  },
  "dependencies": {
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@opsydyn/foldkit-zloz": "workspace:*",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "publint": "0.3.25",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@opsydyn/foldkit-zloz": "0.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
