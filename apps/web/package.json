    "@opsydyn/testing": "workspace:*",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/html": "^10.4.6",
    "@storybook/html-vite": "^10.4.6",
    "@types/node": "catalog:",
