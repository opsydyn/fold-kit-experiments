      "topojson-client": "^3.1.0",
      "tsdown": "^0.21.8",
      "typescript": "^6.0.3",
      "vitest": "^5.0.5",
      "vscode-oniguruma": "2.0.1",
      "world-atlas": "^2.0.2",
      "wrangler": "^4.125.0",
      "elkjs": "0.12.1",
      "typedoc": "^0.28.19",
      "axe-core": "4.14.1",
