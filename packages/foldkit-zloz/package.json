{
  "name": "@opsydyn/foldkit-zloz",
  "version": "0.1.0",
  "description": "Model-owned graph editing and optional native FoldKit views.",
  "keywords": [
    "diagram",
    "flow",
    "foldkit",
    "graph",
    "typescript"
  ],
  "homepage": "https://github.com/opsydyn/fold-kit-experiments/tree/main/packages/foldkit-zloz#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/fold-kit-experiments/issues"
  },
  "license": "MIT",
  "author": "Alan P Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/foldkit-zloz"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./foldkit": {
      "types": "./dist/foldkit.d.mts",
      "import": "./dist/foldkit.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "bench:choosers": "bun bench/choosers.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "pack:check": "bun run build && publint && bun ../../tools/pack-zloz.ts foldkit-zloz",
    "docs": "bun run --filter @opsydyn/foldkit-zloz build && bun run --filter @opsydyn/foldkit-viz build && typedoc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "effect": "4.1.0",
    "fast-check": "^4.8.0",
    "foldkit": "0.170.0",
    "happy-dom": "^20.10.6",
    "publint": "0.3.25",
    "tsdown": "^0.21.8",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "effect": ">=4.1.0 <5.0.0",
    "foldkit": ">=0.170.0 <0.171.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
