{
  "name": "@opsydyn/foldkit-phosphor",
  "version": "0.1.0",
  "private": true,
  "description": "Phosphor SVG artwork for Effect UI, with a separate static asset compiler.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "PHOSPHOR-LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./effect-ui": {
      "types": "./dist/effect-ui.d.mts",
      "import": "./dist/effect-ui.mjs"
    },
    "./compile": {
      "types": "./dist/compile.d.mts",
      "import": "./dist/compile.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test ./test"
  },
  "dependencies": {
    "sax": "catalog:"
  },
  "devDependencies": {
    "@effect/ui": "catalog:",
    "@phosphor-icons/core": "catalog:",
    "@types/sax": "catalog:",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/ui": "0.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/ui": {
      "optional": true
    }
  }
}
