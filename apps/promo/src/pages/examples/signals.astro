---
import Layout from '../../layouts/Layout.astro';
import {sitePath} from '../../lib/site-path';
import Signals from '../../examples/signals/app';
import {signalData} from '../../examples/signals/data';
import ExampleSource from '../../components/ExampleSource.astro';
import data from '../../examples/signals/data.ts?raw';
import model from '../../examples/signals/model.ts?raw';
import message from '../../examples/signals/message.ts?raw';
import update from '../../examples/signals/update.ts?raw';
import derive from '../../examples/signals/derive.ts?raw';
import input from '../../examples/signals/input.ts?raw';
import view from '../../examples/signals/view.ts?raw';
const sources=[{name:'data.ts',content:data},{name:'model.ts',content:model},{name:'message.ts',content:message},{name:'update.ts',content:update},{name:'derive.ts',content:derive},{name:'input.ts',content:input},{name:'view.ts',content:view}];
---
<Layout title="Signal desk — Foldkit Viz">
<section class="page-intro"><a class="text-link" href={sitePath('/examples/')}>← All examples</a><p class="eyebrow">CONTROLLED EXPLORATION</p><h1>Find the moment.<br/>Follow the signal.</h1><p>Brush a time range. Pan the details. Pin an observation across latency, errors and raw data. Pure geometry follows explicit Foldkit state.</p><p class="signal-context">Illustrative static telemetry. Independent Y scales stay fixed as you explore time. This example demonstrates composition, not a production monitoring system.</p></section>
<Signals client:load noMeta data={signalData}/>
<noscript><p>Enable JavaScript for inspection and controls. The charts and full raw observation table remain available below.</p></noscript>
<ExampleSource files={sources}/>
</Layout>
