---
import * as barStyles from '../../apps/bar/bar.css';
import Layout from '../../layouts/Layout.astro';
import * as layoutStyles from '../../layouts/layout.css';

const samples = [
  {
    href: '/effect-three/playground',
    title: 'Reconciliation playground',
    body: 'Add, move, reorder, repaint and remove keyed cubes that glide into place on a fading shader grid, and watch exactly which operations each update takes and which GPU resources it holds.',
  },
  {
    href: '/effect-three/sculpture',
    title: 'Sculpture and time travel',
    body: 'Stack blocks, balls and drums by clicking in 3D. The DevTools are in time-travel mode: pick any history row and the scene rewinds with the Model.',
  },
  {
    href: '/effect-three/studio',
    title: 'Studio: lights, materials and drag',
    body: 'Drag five pieces in five material kinds under hemisphere, point and spot lights with soft shadows. Orbit, pan and zoom toward the pointer, frame the pieces, right-click for a new finish; toggle tone mapping and an orthographic camera.',
  },
  {
    href: '/effect-three/city',
    title: 'City: 10,000 instances',
    body: 'Ten thousand buildings in one instanced mesh and one draw call. Hover and click change one instance each, and the scene draws only when something changes.',
  },
  {
    href: '/effect-three/workshop',
    title: 'Workshop: models, textures and clips',
    body: 'A glTF robot, a floor texture and a font for 3D text load through Commands into AsyncData, with a crisp troika caption naming the clip. Play its clips, click its parts, and unload it all from the GPU.',
  },
  {
    href: '/effect-three/toybox',
    title: 'Toybox: physics, joints and VR',
    body: 'Crates and balls tumble into a tray under Rapier, a chain swings from a hook on joints, and marbles pour in as one instanced mesh with a body each. Kick toys with a click; in VR, point and pull the trigger, and glide and turn with the thumbsticks.',
  },
  {
    href: '/effect-three/marbles',
    title: 'Marble machine: motors, groups and sensors',
    body: 'Gold and teal marbles ride a motor-driven paddle wheel onto a grate only teal marbles can touch. Collision groups sort them, named sensors count each bin, and contact forces measure every knock on the wheel.',
  },
  {
    href: '/effect-three/gallery',
    title: 'Type gallery: curved, coloured and lit labels',
    body: 'A dark gallery of troika labels: a title following the curved wall, a code plaque coloured by colour ranges, spotlit type with a lit material, and panels sized from each label’s measured layout.',
  },
  {
    href: '/effect-three/bowling',
    title: 'Bowling: sensors and a scoreboard',
    body: 'Aim and roll at ten pins. Named sensors at each pin’s head say which fell, a pit sensor says the ball went through, and a troika scoreboard keeps ten-pin score.',
  },
  {
    href: '/effect-three/room',
    title: 'XR room: anchors, planes and meshes',
    body: 'Furnish a room with plants, or let an agent do it through the Foldkit DevTools MCP server. In VR, glide with the sticks while tips ride your left hand; in AR, plants are anchors and detected planes and meshes are drawn from Messages.',
  },
  {
    href: '/effect-three/bars',
    title: '3D bar chart',
    body: 'Foldkit Viz scales place the bars; effect-three eases them when the data changes. Hover, pin, isolate a series, and read it all in the data table.',
  },
  {
    href: '/effect-three/shared',
    title: 'Shared resources',
    body: 'Two cubes share one geometry and one material. Repaint, resize, remove one, or unmount the whole scene and its WebGL context.',
  },
];
---

<Layout title="effect-three samples — Astro + FoldKit">
  <h1 class={layoutStyles.heading}>effect-three</h1>
  <p>Declarative Three.js scenes for Foldkit: the scene is plain data derived from the Model.</p>
  {
    samples.map((sample) => (
      <a class={barStyles.card} href={sample.href} style="display:block;margin-bottom:1rem;color:inherit;text-decoration:none">
        <h2>{sample.title}</h2>
        <p>{sample.body}</p>
      </a>
    ))
  }
</Layout>
