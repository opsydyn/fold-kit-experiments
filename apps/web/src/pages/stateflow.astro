---
export const prerender = false;

import { resolvePageDocument } from '@opsydyn/astro-foldkit/server';

import StateflowPage from '../apps/stateflow/page';
import Layout from '../layouts/Layout.astro';
import * as layoutStyles from '../layouts/layout.css';

const document = await resolvePageDocument(StateflowPage, {
  request: Astro.request,
  url: Astro.url,
  params: Astro.params,
  props: {},
});
---

<Layout title={document.title}>
  <h1 class={layoutStyles.heading}>Stateflow Observatory</h1>
  <StateflowPage client:load />
</Layout>
