{
  "name": "@opsydyn/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:integration": "tsc --noEmit -p test/integration && bun test test/integration",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "bun run test:e2e e2e/agent-analysis.smoke.spec.ts",
    "typecheck": "astro check",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && oxfmt --check .",
    "check:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types\" oxlint --fix .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:zloz:release": "playwright test --config playwright.zloz.config.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
