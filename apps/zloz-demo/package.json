{
  "name": "@opsydyn/zloz-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild-packages": "bun run --filter @opsydyn/astro-foldkit build && bun run --filter @opsydyn/foldkit-zloz-elk build && bun run --filter @opsydyn/foldkit-zloz-force build && bun run --filter @opsydyn/foldkit-zloz-mermaid build && bun run --filter @opsydyn/foldkit-zloz-alchemy build",
    "dev": "bun run prebuild-packages && astro dev",
    "build": "bun run prebuild-packages && astro build",
    "preview": "astro preview",
    "typecheck": "bun run prebuild-packages && astro check",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@effect/ui": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@opsydyn/astro-effect-ui": "workspace:*",
    "@opsydyn/astro-foldkit": "workspace:*",
    "@opsydyn/foldkit-zloz": "workspace:*",
    "@opsydyn/foldkit-zloz-alchemy": "workspace:*",
    "@opsydyn/foldkit-zloz-elk": "workspace:*",
    "@opsydyn/foldkit-zloz-force": "workspace:*",
    "@opsydyn/foldkit-zloz-mermaid": "workspace:*",
    "astro": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@effect/vitest": "catalog:",
    "@opsydyn/testing": "workspace:*",
    "bun-types": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
