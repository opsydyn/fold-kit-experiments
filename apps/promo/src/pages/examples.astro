---
import Chart from '../components/Chart.astro';
import Layout from '../layouts/Layout.astro';
import { comparisonExample, examples, sourceRoot } from '../lib/examples';
---
<Layout title="Examples — Foldkit Viz">
  <section class="page-intro">
    <p class="eyebrow">Explore the primitives</p>
    <h1>A shape for every story.</h1>
    <p>Six starting points for your next visualisation. Every chart is SVG, built with Foldkit Viz.</p>
    <p class="small-note">All datasets are illustrative. Map boundaries: Natural Earth via world-atlas.</p>
  </section>
  <section class="live-example-callout"><p class="eyebrow">NEW / INTERACTIVE</p><h2>Try it. Read it. Make it yours.</h2><p>Shape a line, regroup a distribution or inspect a scatter plot. Read the code as you experiment, then take the working example into your own project.</p><div class="live-example-actions"><a class="button button-primary" href="/examples/line/">Explore the live line →</a><a class="button button-secondary" href="/examples/histogram/">Explore the live histogram →</a><a class="button button-secondary" href="/examples/scatter/">Explore the live scatter →</a></div></section>
  <div class="examples-list">
    <a class="button button-secondary" href={comparisonExample.href}>{comparisonExample.title}</a>
    {examples.map((example, i) => <section class="example-detail" id={example.id} aria-labelledby={example.id + '-heading'}>
      <div class="example-explanation">
        <p class="eyebrow">{String(i + 1).padStart(2, '0') + ' / ' + example.category}</p>
        <h2 id={example.id + '-heading'}>{example.title}</h2>
        <p>{example.description}</p>
        <code class="module-path">{'@opsydyn/foldkit-viz/' + example.module}</code>
        <a class="text-link" href={sourceRoot + '/' + example.module + '.ts'}>Explore the source <span aria-hidden="true">↗</span></a>
      </div>
      <div class="example-plot">
        {example.id === 'curves' ? <div class="curve-comparison">
          <fieldset class="curve-controls">
            <legend>Interpolation</legend>
            <input type="radio" name="curve" id="curve-smooth" value="catmullRom" checked />
            <label for="curve-smooth">Smooth</label>
            <input type="radio" name="curve" id="curve-linear" value="linear" />
            <label for="curve-linear">Linear</label>
            <input type="radio" name="curve" id="curve-step" value="step" />
            <label for="curve-step">Step</label>
          </fieldset>
          <Chart kind={example.id} label="Compare smooth, linear and stepped curves" />
        </div> : <Chart kind={example.id} label={example.title} />}
      </div>
    </section>)}
  </div>
  <section class="closing-callout"><h2>Make the next one yours.</h2><a class="button button-primary" href="/docs/#quick-start">Build your first chart <span aria-hidden="true">→</span></a></section>
</Layout>
