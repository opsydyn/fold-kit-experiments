---
import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../lib/site-path';
import { words } from '../../examples/wordcloud/data';
import WordCloud from '../../examples/wordcloud/app';
import ExampleSource from '../../components/ExampleSource.astro';
import dataSource from '../../examples/wordcloud/data.ts?raw';
import domainSource from '../../examples/wordcloud/domain.ts?raw';
import modelSource from '../../examples/wordcloud/model.ts?raw';
import messageSource from '../../examples/wordcloud/message.ts?raw';
import commandSource from '../../examples/wordcloud/command.ts?raw';
import updateSource from '../../examples/wordcloud/update.ts?raw';
import viewSource from '../../examples/wordcloud/view.ts?raw';
const sources = [{ name: 'data.ts', content: dataSource },{ name: 'domain.ts', content: domainSource },{ name: 'model.ts', content: modelSource },{ name: 'message.ts', content: messageSource },{ name: 'command.ts', content: commandSource },{ name: 'update.ts', content: updateSource },{ name: 'view.ts', content: viewSource }];
---
<Layout title="Word cloud — Foldkit Viz">
  <section class="page-intro"><a class="text-link" href={sitePath('/examples/')}>← All examples</a><p class="eyebrow">LEARN BY CHANGING</p><h1>Give words weight.</h1><p>A measured, deterministic layout. Change the spiral, font, rotation and spacing. Foldkit keeps controls explicit; pure TypeScript finds space for each word.</p></section>
  <WordCloud client:load noMeta words={words} />
  <noscript><p>This example needs JavaScript to measure text and place words. The complete vocabulary and weights are available in the source.</p></noscript>
  <section class="closing-callout"><h2>Measured once. Composed freely.</h2><p>Font measurement runs in a Command. The layout accepts those measurements and returns SVG coordinates. Conservative bounding boxes keep words apart; words that cannot fit are reported.</p><a class="text-link" href="https://github.com/opsydyn/fold-kit-experiments/tree/main/packages/foldkit-viz/src/layout/wordcloud.ts">Explore the layout source →</a></section>
  <ExampleSource files={sources} />
</Layout>
