      "@types/topojson-client": "^3.1.5",
      "@vanilla-extract/css": "^1.21.1",
      "@vanilla-extract/vite-plugin": "^5.2.4",
      "ajv": "8.20.0",
      "apache-arrow": "17.0.0",
      "astro": "7.4.11",
      "bun-types": "^1.3.14",
      "effect": "4.1.6",
      "fast-check": "^4.8.0",
      "likec4": "1.61.0",
      "happy-dom": "^21.0.4",
      "hast-util-to-html": "^9.0.5",
      "oxlint": "1.79.0",
      "oxlint-tsgolint": "7.0.2004",
      "pixelmatch": "8.0.0",
      "playwright": "1.64.1",
      "pngjs": "7.0.0",
      "publint": "0.3.25",
      "satori": "0.60.0",
      "sharp": "0.35.5",
