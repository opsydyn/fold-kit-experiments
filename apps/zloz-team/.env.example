ZLOZ_ORIGIN=http://localhost:4331
# Alchemy generates and persists the signing secret in local stack state.
# Google provider setup is required for real sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional local operator task. Generate with: openssl rand -hex 32
ZLOZ_OPERATOR_TOKEN=
# For staging, use a separate Google client and change ZLOZ_ORIGIN to:
# https://teams-staging.opsydyn.xyz
# Authorized redirect URI: https://teams-staging.opsydyn.xyz/api/auth/callback/google
# Explicit staging-only operator bridge; disable after first-owner bootstrap.
ZLOZ_STAGING_BOOTSTRAP=false
