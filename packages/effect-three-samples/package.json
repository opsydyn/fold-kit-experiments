{
  "name": "@opsydyn/effect-three-samples",
  "private": true,
  "description": "effect-three sample applications shared by apps/web and apps/three-promo.",
  "type": "module",
  "exports": {
    "./bars": "./src/bars/main.ts",
    "./city": "./src/city/main.ts",
    "./hero": "./src/hero/main.ts",
    "./playground": "./src/playground/main.ts",
    "./sculpture": "./src/sculpture/main.ts",
    "./studio": "./src/studio/main.ts",
    "./toybox": "./src/toybox/main.ts",
    "./workshop": "./src/workshop/main.ts",
    "./marbles": "./src/marbles/main.ts",
    "./gallery": "./src/gallery/main.ts",
    "./bowling": "./src/bowling/main.ts",
    "./room": "./src/room/main.ts",
    "./curves": "./src/curves/main.ts",
    "./arrange": "./src/arrange/main.ts",
    "./editor": "./src/editor/main.ts",
    "./shared": "./src/shared/main.ts",
    "./styles.css": "./src/styles.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "bun test ./test",
    "make:assets": "bun scripts/make-robot.ts ../../apps/three-promo/public/models/robot.glb ../../apps/web/public/models/robot.glb ../effect-three-foldkit/e2e/app/robot.glb && bun scripts/make-tiles.ts ../../apps/three-promo/public/models/tiles.png ../../apps/web/public/models/tiles.png",
    "typecheck": "bun run --filter @opsydyn/foldkit-viz build && bun run --filter @opsydyn/effect-three build && bun run --filter @opsydyn/effect-three-foldkit build && tsc --noEmit"
  },
  "dependencies": {
    "@opsydyn/effect-three": "workspace:*",
    "@opsydyn/effect-three-foldkit": "workspace:*",
    "@opsydyn/effect-three-rapier": "workspace:*",
    "@opsydyn/effect-three-troika": "workspace:*",
    "@opsydyn/foldkit-viz": "workspace:*",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/pngjs": "catalog:",
    "bun-types": "catalog:",
    "pngjs": "catalog:",
    "typescript": "catalog:"
  }
}
