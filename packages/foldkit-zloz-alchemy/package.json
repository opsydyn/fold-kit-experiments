{
  "name": "@opsydyn/foldkit-zloz-alchemy",
  "version": "0.0.0",
  "private": true,
  "description": "Private read-only Alchemy declaration inspection and portable Zloz projection.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./domain": {
      "types": "./dist/domain.d.mts",
      "import": "./dist/domain.mjs"
    },
    "./package.json": "./package.json",
    "./collaboration": {
      "types": "./dist/collaboration.d.mts",
      "import": "./dist/collaboration.mjs"
    },
    "./assessment": {
      "types": "./dist/assessment.d.mts",
      "import": "./dist/assessment.mjs"
    },
    "./checkpoint": {
      "types": "./dist/checkpoint.d.mts",
      "import": "./dist/checkpoint.mjs"
    },
    "./delta": {
      "types": "./dist/delta.d.mts",
      "import": "./dist/delta.mjs"
    },
    "./hash": {
      "types": "./dist/hash.d.mts",
      "import": "./dist/hash.mjs"
    },
    "./session": {
      "types": "./dist/session.d.mts",
      "import": "./dist/session.mjs"
    }
  },
  "scripts": {
    "build": "bun run --filter @opsydyn/foldkit-zloz build && tsdown",
    "typecheck": "bun run --filter @opsydyn/foldkit-zloz build && tsc --noEmit && tsc --noEmit -p tsconfig.collaboration.json",
    "test": "bun run test:unit && bun run test:package",
    "test:unit": "bun run build && bun test ./test --path-ignore-patterns='**/*package.test.ts'",
    "test:package": "bun test ./test/package.test.ts ./test/collaboration-package.test.ts",
    "pack:check": "bun run build && publint && bun pm pack --destination dist/pack"
  },
  "devDependencies": {
    "@alchemy.run/domain": "catalog:infra",
    "@opsydyn/foldkit-zloz": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:infra",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@opsydyn/foldkit-zloz": "workspace:*",
    "alchemy": "2.0.0-beta.85",
    "effect": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/domain": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  }
}
