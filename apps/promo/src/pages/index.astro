---
import { sitePath } from '../lib/site-path';
import SourceCode from '../components/SourceCode.astro';
import Chart from '../components/Chart.astro';
import HeroChart from '../components/HeroChart.astro';
import Layout from '../layouts/Layout.astro';
import { examples } from '../lib/examples';
const teaser = "const x = linear({ domain: [0, 10], range: [0, 400] });\nconst path = line(points, { curve: 'catmullRom' });";
---
<Layout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">Visualisation primitives for FoldKit</p>
      <h1 id="hero-heading">Give your<br />data<br />shape.</h1>
      <p class="hero-description">Build expressive charts with <a href="https://foldkit.dev/">Foldkit</a>, the TypeScript frontend framework built on Effect. Pure geometry. Composable SVG. State and interaction you can understand.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={sitePath('/examples/signals/')}>Explore Signal Desk <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={sitePath('/examples/')}>All examples</a>
      </div>
    </div>
    <HeroChart />
  </section>
  <section class="showcase" aria-labelledby="showcase-heading">
    <div class="section-heading">
      <div><p class="eyebrow">New / In the workspace</p><h2 id="showcase-heading">Follow a signal. Find the words.</h2></div>
      <a class="text-link" href={sitePath('/docs/#signal-exploration')}>Explore the primitives <span aria-hidden="true">→</span></a>
    </div>
    <div class="showcase-grid">
      <article class="showcase-example showcase-signal">
        <a class="showcase-preview" href={sitePath('/examples/signals/')} aria-label="Explore Signal Desk">
          <img class="showcase-image showcase-light" src={sitePath('/images/showcase/signals-light.png')} width="2056" height="590" loading="lazy" decoding="async" alt="Signal Desk preview: latency over time, with explicit gaps and a supplied interval around estimated observations." />
          <img class="showcase-image showcase-dark" src={sitePath('/images/showcase/signals-dark.png')} width="2056" height="590" loading="lazy" decoding="async" alt="Signal Desk preview: latency over time, with explicit gaps and a supplied interval around estimated observations." />
        </a>
        <div class="showcase-caption"><h3>Signal Desk</h3><a class="text-link" href={sitePath('/examples/signals/')}>Explore the timeline <span aria-hidden="true">→</span></a></div>
        <p>A moment in context. Missing observations, supplied intervals and a baseline that stays put.</p>
      </article>
      <article class="showcase-example showcase-cloud">
        <a class="showcase-preview" href={sitePath('/examples/wordcloud/')} aria-label="Explore word cloud">
          <img class="showcase-image showcase-light" src={sitePath('/images/showcase/wordcloud-light.png')} width="2056" height="702" loading="lazy" decoding="async" alt="Word-cloud preview: visualisation vocabulary arranged without overlap and sized by illustrative weight." />
          <img class="showcase-image showcase-dark" src={sitePath('/images/showcase/wordcloud-dark.png')} width="2056" height="702" loading="lazy" decoding="async" alt="Word-cloud preview: visualisation vocabulary arranged without overlap and sized by illustrative weight." />
        </a>
        <div class="showcase-caption"><h3>Word cloud</h3><a class="text-link" href={sitePath('/examples/wordcloud/')}>Explore the words <span aria-hidden="true">→</span></a></div>
        <p>Give words their weight. Measured type, deliberate space and a layout you can reshape.</p>
      </article>
    </div>
  </section>
  <section class="principles" aria-label="Why Foldkit Viz">
    <div><h2>Pure geometry</h2><p>Scales, shapes and layouts in pure TypeScript. No D3 dependency.</p></div>
    <div><h2>Composable primitives</h2><p>Start with a scale. Add a shape. Bring your data, colours and creative direction.</p></div>
    <div><h2>Explicit interaction</h2><p>Build on Foldkit’s model, messages and commands. Trace how your charts behave, test their state, and extend them with confidence.</p></div>
  </section>
  <section class="gallery-section" aria-labelledby="gallery-heading">
    <div class="section-heading">
      <h2 id="gallery-heading">A few shapes of possibility.</h2>
      <a class="text-link" href={sitePath('/examples/')}>View all examples <span aria-hidden="true">→</span></a>
    </div>
    <div class="gallery-grid">
      {examples.map((example) => <a class="example-card" href={sitePath('/examples/#' + example.id)}>
        <span class="eyebrow">{example.category}</span>
        <Chart kind={example.id} label={example.title} />
        <div class="card-caption"><h3>{example.title}</h3><span class="card-arrow" aria-hidden="true">↗</span></div>
      </a>)}
    </div>
    <p class="gallery-note">Real primitives. Illustrative data. Yours to make your own.</p>
  </section>
  <section class="quick-start-teaser" aria-labelledby="code-heading">
    <div>
      <h2 id="code-heading">From values to visuals.</h2>
      <p>Start with a scale. Add a shape. Make it yours.</p>
      <a class="text-link" href={sitePath('/docs/#quick-start')}>Read the quick start <span aria-hidden="true">→</span></a>
    </div>
    <div class="code-panel"><span class="code-language" aria-hidden="true">ts</span><SourceCode code={teaser} lang="ts" sourceId="geometry.ts" /></div>
  </section>
</Layout>
