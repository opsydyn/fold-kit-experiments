---
/*
 * A page that scrolls: the 2D radar and the full pages. Each works without JavaScript.
 */
import { categoryIds, categoryLabels } from '../radar/three/data';
import { editions, radarTitle } from '../radar/radar';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{radarTitle}</a>
      <nav aria-label="Site">
        <a href="/">3D radar</a>
        <a href="/2d/">2D radar</a>
        {categoryIds.map((id) => <a href={`/category/${id}/`}>{categoryLabels[id]}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Editions">
        <span>Editions:</span>
        {editions.map((edition) => <a href={`/edition/${edition.date}/`}>{edition.label}</a>)}
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --page: #0a0a14;
    --surface: #12121f;
    --border: #2a2a3d;
    --text: #e8e8f0;
    --muted: #a3a3bd;
    --accent: #8fb0ff;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--page);
    color: var(--text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  main {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.2;
  }

  h2 {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
  }

  .site-header,
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    border-bottom: none;
    color: var(--muted);
  }

  .site-header nav,
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .site-name {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
  }

  .muted {
    color: var(--muted);
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 0.35rem 0.75rem 0.35rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
</style>
