---
import AppLayout from '../layouts/AppLayout.astro';
import { pages, radar, radarTitle } from '../radar/radar';
import Radar from '../radar/three/app';

// Rendered per request, so the query string reaches the server: it is a deep link, and the
// radar opens on the view it describes.
export const prerender = false;

const link = Object.fromEntries(Astro.url.searchParams);
---

<AppLayout title={radarTitle}>
  <Radar
    client:load
    dataset={radar}
    title={radarTitle}
    pages={pages}
    assetBase="/models/"
    link={link}
  />
</AppLayout>
