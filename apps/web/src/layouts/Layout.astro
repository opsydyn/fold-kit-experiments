---
import * as styles from './layout.css';
import '../styles/chart-tokens.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  lang?: string;
  dir?: 'ltr' | 'rtl' | 'auto';
  canonical?: string;
  ogUrl?: string;
  clientNavigation?: boolean;
}
const { title, lang = 'en', dir = 'ltr', canonical, ogUrl, clientNavigation = false } = Astro.props;
const path = new URL(Astro.request.url).pathname;

const linkClass = (href: string) =>
  href === path ? `${styles.navLink} ${styles.navLinkActive}` : styles.navLink;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {canonical !== undefined && <link rel="canonical" href={canonical} />}
    {ogUrl !== undefined && <meta property="og:url" content={ogUrl} />}
    <title>{title}</title>
    {clientNavigation && <ClientRouter />}
    <script is:inline>
      // Restore theme before first paint to avoid flash
      const stored = localStorage.getItem('foldkit-theme');
      if (stored === 'light') document.documentElement.setAttribute('data-theme', 'light');
    </script>
  </head>
  <body data-client-navigation={clientNavigation ? 'true' : undefined}>
    <nav class={styles.nav}>
      <a href="/" class={linkClass('/')}>Home</a>
      <a href="/health" class={linkClass('/health')}>Health</a>
      <a href="/greeting" class={linkClass('/greeting')}>Greeting</a>
      <a href="/timestamp" class={linkClass('/timestamp')}>Timestamp</a>
      <a href="/profile" class={linkClass('/profile')}>Profile</a>
      <a href="/welcome" class={linkClass('/welcome')}>Welcome</a>
      <a href="/carousel" class={linkClass('/carousel')}>Carousel</a>
      <a href="/request-diagnostics" class={linkClass('/request-diagnostics')}>Diagnostics</a>
      <a href="/charts" class={linkClass('/charts')}>Charts</a>
      <a href="/stateflow" class={linkClass('/stateflow')}>Stateflow</a>
      <button id="theme-toggle" class={styles.themeToggle} aria-label="Toggle light/dark mode">◑</button>
    </nav>
    <main class={styles.main}>
      <slot />
    </main>
  </body>
</html>

<script>
  import { themeAtom, applyTheme } from '../stores/theme';

  // Sync store → DOM on every change
  themeAtom.subscribe(applyTheme);

  const toggleTheme = () => {
    themeAtom.set(themeAtom.get() === 'dark' ? 'light' : 'dark');
  };
  const bindThemeToggle = () => {
    // A stable callback is deduplicated by EventTarget, including repeated page-load facts.
    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    applyTheme(themeAtom.get());
  };
  bindThemeToggle();
  if (document.body.dataset.clientNavigation === 'true') {
    document.addEventListener('astro:page-load', () => {
      if (document.body.dataset.clientNavigation === 'true') bindThemeToggle();
    });
  }
</script>
