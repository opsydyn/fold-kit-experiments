---
import { sitePath } from '../lib/site-path';
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
---
<a class:list={['brand', { 'brand-footer': footer }]} href={sitePath('/')} aria-label="Foldkit Viz home">
  <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
    <path d="M2 4h17l9 10H11Z" fill="var(--blue)" />
    <path d="M11 14h17l-9 7H2Z" fill="var(--gold)" />
    <path d="M2 21h17l9-7v14H11Z" fill="var(--coral)" />
    <path d="M2 4l9 10-9 7Z" fill="var(--periwinkle)" />
  </svg>
  <span>Foldkit Viz</span>
</a>
