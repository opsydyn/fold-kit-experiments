{
  "name": "@opsydyn/effect-three-troika",
  "version": "0.4.0",
  "description": "Troika distance-field text for @opsydyn/effect-three: crisp labels described as data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/effect-three-troika"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/.tsbuildinfo",
    "!dist/api-extractor",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "bun": "./src/webgpu.ts",
      "default": "./dist/webgpu.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "bunx --bun oxlint --config oxlint.strict.ts",
    "check": "bun run lint",
    "test": "bun test --pass-with-no-tests ./src ./test",
    "build": "tsc -b && bun build ./src/index.ts ./src/webgpu.ts --root ./src --outdir ./dist --target browser --packages external --splitting --sourcemap=linked",
    "api:report": "api-extractor run --local",
    "api:check": "api-extractor run",
    "pack:check": "bun run build && publint && rm -rf dist/pack && bun pm pack --destination dist/pack && attw dist/pack/*.tgz --profile esm-only"
  },
  "dependencies": {
    "troika-three-text": "0.52.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.59.4",
    "@opsydyn/effect-three": "workspace:*",
    "@opsydyn/oxlint-effect": "2.0.1",
    "@types/bun": "1.4.3",
    "@types/three": "0.186.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "three": "0.186.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opsydyn/effect-three": "0.4.0",
    "three": ">=0.186.0 <0.187.0"
  }
}
