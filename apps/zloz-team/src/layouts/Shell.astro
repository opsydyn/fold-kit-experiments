---
import '../styles/workspace.css';
import Appearance from '../appearance/app';
import { themeCookie, themePreference } from '../appearance/preferences';
import mark from '../../../../docs/assets/zloz/final/mark.svg?raw';
interface Props { title: string; wide?: boolean; board?: boolean }
const { title, wide = false, board = false } = Astro.props;
const preference = themePreference(Astro.cookies.get(themeCookie)?.value);
---
<!doctype html>
<html lang="en" data-team-theme={preference}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Zloz teams</title>
  </head>
  <body class:list={{ 'board-page': board }}>
    <header class="site-header">
      <a href="/" class="brand"><span class="brand-mark" aria-hidden="true" set:html={mark} /><span><strong>Foldkit Zloz</strong><small>Team architecture workspace</small></span></a>
      <slot name="board-title" />
      <Appearance client:load noMeta preference={preference} />
    </header>
    <main class:list={[board ? 'board-content' : 'page-content', { wide }]}><slot /></main>
  </body>
</html>
