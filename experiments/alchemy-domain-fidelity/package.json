{
  "name": "@opsydyn/zloz-alchemy-domain-fidelity-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Private read-only Alchemy adapter qualification candidate; requires unreleased native core contracts.",
  "files": [
    "dist/adapter.js",
    "dist/adapter.d.ts",
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/adapter.js",
  "types": "./dist/adapter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
