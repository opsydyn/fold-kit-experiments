{
  "name": "@opsydyn/effect-three-foldkit",
  "version": "0.6.1",
  "description": "Thin Foldkit adapter for @opsydyn/effect-three.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/effect-three-foldkit"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/.tsbuildinfo",
    "!dist/api-extractor",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b . ../effect-three-troika && tsc -p tsconfig.test.json",
    "lint": "bunx --bun oxlint --config oxlint.strict.ts",
    "check": "bun run lint",
    "test": "bun test --pass-with-no-tests ./src ./test",
    "test:e2e": "bun test ./e2e",
    "build": "tsc -b && bun build ./src/index.ts --root ./src --outdir ./dist --target browser --packages external --sourcemap=linked",
    "api:report": "api-extractor run --local",
    "api:check": "api-extractor run",
    "pack:check": "bun run build && publint && rm -rf dist/pack && bun pm pack --destination dist/pack && attw dist/pack/*.tgz --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@effect/platform-browser": "4.0.0",
    "@fontsource/inter": "5.3.0",
    "@microsoft/api-extractor": "7.59.4",
    "@opsydyn/effect-three": "workspace:*",
    "@opsydyn/effect-three-troika": "workspace:*",
    "@opsydyn/oxlint-effect": "2.0.1",
    "@types/bun": "1.4.3",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "effect": "4.0.0",
    "foldkit": "0.167.0",
    "iwer": "2.5.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "publint": "0.3.25",
    "three": "0.186.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opsydyn/effect-three": "0.6.1",
    "effect": "^4.0.0",
    "foldkit": "0.167.0",
    "three": ">=0.186.0 <0.187.0"
  }
}
