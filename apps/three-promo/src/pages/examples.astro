---
import Layout from '../layouts/Layout.astro';
import { examples } from '../lib/examples';
import { samplesSource } from '../lib/links';
import { sitePath } from '../lib/site-path';
---
<Layout title="Examples — effect-three">
  <section class="page-intro">
    <p class="eyebrow">Learn by changing</p>
    <h1>Scenes you can poke.</h1>
    <p>Three live examples, each a small Foldkit application. Change the state and watch the scene follow, then read the source beside it.</p>
  </section>
  <div class="examples-list">
    {examples.map((example, i) => <section class="example-detail" id={example.id} aria-labelledby={example.id + '-heading'}>
      <div class="example-explanation">
        <p class="eyebrow">{String(i + 1).padStart(2, '0') + ' / ' + example.category}</p>
        <h2 id={example.id + '-heading'}>{example.title}</h2>
        <p>{example.description}</p>
        <a class="text-link" href={sitePath(`/examples/${example.id}/`)}>Try the live example →</a>
        <code class="module-path">{'@opsydyn/effect-three-samples/' + example.id}</code>
        <a class="text-link" href={`${samplesSource}/${example.id}`}>Explore the source <span aria-hidden="true">↗</span></a>
      </div>
      <div class="example-plot">
        <img class="showcase-image showcase-light" src={sitePath(`/images/showcase/${example.id}-light.png`)} width="1776" height="762" loading="lazy" decoding="async" alt={example.alt} />
        <img class="showcase-image showcase-dark" src={sitePath(`/images/showcase/${example.id}-dark.png`)} width="1776" height="762" loading="lazy" decoding="async" alt={example.alt} />
      </div>
    </section>)}
  </div>
  <section class="closing-callout"><h2>Make the next one yours.</h2><a class="button button-primary" href={sitePath('/docs/#first-scene')}>Build your first scene <span aria-hidden="true">→</span></a></section>
</Layout>
<style>
  .example-plot .showcase-image { width: 100%; height: auto; border-radius: 12px; }
</style>
