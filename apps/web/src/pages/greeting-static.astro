---
export const prerender = true;

import { Schema } from 'effect';

import GreetingPage from '../apps/greeting/app';
import { localeFromUrl, presentationFor } from '../apps/greeting/presentation';
import { Name } from '../apps/greeting/model';
import Layout from '../layouts/Layout.astro';
import * as layoutStyles from '../layouts/layout.css';

const name = Schema.decodeSync(Name)('static astronaut');
const locale = localeFromUrl(Astro.url);
const metadata = presentationFor({ name, locale });
---

<Layout
  title={metadata.title}
  lang={metadata.lang}
  dir={metadata.dir}
  canonical={metadata.canonical}
  ogUrl={metadata.ogUrl}
>
  <h1 class={layoutStyles.heading}>Greeting</h1>
  <GreetingPage client:load name={name} locale={locale} />
</Layout>
