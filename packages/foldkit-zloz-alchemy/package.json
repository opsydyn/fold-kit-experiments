{
  "name": "@opsydyn/foldkit-zloz-alchemy",
  "version": "0.0.0",
  "private": true,
  "description": "Private read-only Alchemy declaration inspection and portable Zloz projection.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./domain": {
      "types": "./dist/domain.d.mts",
      "import": "./dist/domain.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run --filter @opsydyn/foldkit-zloz build && tsdown",
    "typecheck": "bun run --filter @opsydyn/foldkit-zloz build && tsc --noEmit",
    "test": "bun run build && bun test ./test",
    "pack:check": "bun run build && publint && bun pm pack --destination dist/pack"
  },
  "devDependencies": {
    "@alchemy.run/domain": "catalog:infra",
    "@opsydyn/foldkit-zloz": "workspace:*",
    "@types/node": "catalog:",
    "alchemy": "catalog:infra",
    "bun-types": "catalog:",
    "effect": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@opsydyn/foldkit-zloz": "0.3.0",
    "alchemy": "2.0.0-beta.85",
    "effect": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/domain": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  }
}
