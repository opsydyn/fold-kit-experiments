---
export const prerender = false;

import { Option } from 'effect';

import StateflowPage from '../apps/stateflow/page';
import { stateTagOf } from '../apps/stateflow/replay';
import { sessionFrom } from '../apps/stateflow/share';
import { initModel } from '../apps/stateflow/model';
import { withSession } from '../apps/stateflow/update';
import Layout from '../layouts/Layout.astro';
import * as layoutStyles from '../layouts/layout.css';

const session = Option.getOrNull(sessionFrom(Astro.url.href));
const title = `Stateflow Observatory — ${stateTagOf(withSession(initModel, session))}`;
---

<Layout title={title}>
  <h1 class={layoutStyles.heading}>Stateflow Observatory</h1>
  <StateflowPage client:load session={session} />
</Layout>
