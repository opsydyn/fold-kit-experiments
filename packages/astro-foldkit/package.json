{
  "name": "@opsydyn/astro-foldkit",
  "version": "1.0.0-next.0",
  "description": "Compatibility entry point for the standalone Astro Effect UI renderer.",
  "keywords": [
    "astro",
    "astro-integration",
    "effect",
    "effect-ui"
  ],
  "bugs": {
    "url": "https://github.com/opsydyn/fold-kit-experiments/issues"
  },
  "license": "MIT",
  "author": "Alan P Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/astro-foldkit"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "component": [
        "./dist/component.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./component": {
      "types": "./dist/component.d.mts",
      "import": "./dist/component.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --filter @opsydyn/astro-effect-ui build && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "check": "NODE_OPTIONS=\"--experimental-strip-types\" oxlint . && oxfmt --check .",
    "check:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types\" oxlint --fix .",
    "api:report": "bun ../../tools/api-surface.ts",
    "api:check": "bun ../../tools/api-surface.ts --check",
    "compat:astro": "bun ../../tools/astro-compat.ts"
  },
  "dependencies": {
    "@opsydyn/astro-effect-ui": "1.0.0-next.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "astro": "7.4.11",
    "bun-types": "^1.3.14",
    "effect": "4.1.6",
    "tsdown": "^0.21.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "astro": ">=5.0.0 <8",
    "effect": "~4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
