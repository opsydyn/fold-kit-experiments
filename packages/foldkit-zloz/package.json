{
  "name": "@opsydyn/foldkit-zloz",
  "version": "0.10.0",
  "description": "Model-owned graph editing and optional native FoldKit views.",
  "keywords": [
    "diagram",
    "flow",
    "foldkit",
    "graph",
    "typescript"
  ],
  "homepage": "https://github.com/opsydyn/fold-kit-experiments/tree/main/packages/foldkit-zloz#readme",
  "bugs": {
    "url": "https://github.com/opsydyn/fold-kit-experiments/issues"
  },
  "license": "MIT",
  "author": "Alan P Currie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsydyn/fold-kit-experiments.git",
    "directory": "packages/foldkit-zloz"
  },
  "files": [
    "dist",
    "src/effect-ui.css",
    "src/effect-ui.css.d.mts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "!dist/pack"
  ],
  "type": "module",
  "sideEffects": [
    "./src/effect-ui.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./effect-ui": {
      "types": "./dist/effect-ui.d.mts",
      "import": "./dist/effect-ui.mjs"
    },
    "./effect-ui.css": {
      "types": "./src/effect-ui.css.d.mts",
      "default": "./src/effect-ui.css"
    },
    "./foldkit": {
      "types": "./dist/foldkit.d.mts",
      "import": "./dist/foldkit.mjs"
    },
    "./package.json": "./package.json",
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    },
    "./coupling": {
      "types": "./dist/coupling.d.mts",
      "import": "./dist/coupling.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "bench:choosers": "bun bench/choosers.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:package",
    "test:unit": "bun test ./test --path-ignore-patterns='**/package.test.ts'",
    "test:package": "bun test ./test/package.test.ts",
    "pack:check": "bun run build && publint && bun ../../tools/pack-zloz.ts foldkit-zloz",
    "docs": "bun run build && bun run --filter @opsydyn/foldkit-viz build && typedoc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@77dcd92",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "effect": "4.1.6",
    "fast-check": "^4.8.0",
    "foldkit": "0.171.0",
    "happy-dom": "^21.0.4",
    "publint": "0.3.25",
    "tsdown": "^0.21.8",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@effect/ui": "0.0.0",
    "effect": ">=4.1.0 <5.0.0",
    "foldkit": ">=0.170.0 <0.172.0"
  },
  "peerDependenciesMeta": {
    "@effect/ui": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
