      "@phosphor-icons/core": "2.1.1",
      "@types/sax": "1.2.7",
      "sax": "1.6.1"
    },
    "catalogs": {
      "published": {
        "@opsydyn/astro-effect-ui": "https://registry.npmjs.org/@opsydyn/astro-effect-ui/-/astro-effect-ui-1.0.0-next.0.tgz",
        "@opsydyn/effect-three": "https://registry.npmjs.org/@opsydyn/effect-three/-/effect-three-1.0.0-next.0.tgz",
        "@opsydyn/effect-three-foldkit": "https://registry.npmjs.org/@opsydyn/effect-three-foldkit/-/effect-three-foldkit-1.0.0-next.0.tgz",
        "@opsydyn/effect-three-rapier": "https://registry.npmjs.org/@opsydyn/effect-three-rapier/-/effect-three-rapier-1.0.0-next.0.tgz",
        "@opsydyn/effect-three-troika": "https://registry.npmjs.org/@opsydyn/effect-three-troika/-/effect-three-troika-1.0.0-next.0.tgz",
