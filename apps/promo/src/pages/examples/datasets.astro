---
import { sitePath } from '../../lib/site-path';
import Layout from '../../layouts/Layout.astro';
import DatasetExplorer from '../../examples/datasets/app';
import DatasetLauncher from '../../examples/datasets/launcher/app';
import { datasetSources } from '../../lib/dataset-sources';
---
<Layout title="Live dataset explorer — Foldkit Viz">
  <section class="page-intro">
    <a class="text-link" href={sitePath('/examples/')}>← All examples</a>
    <p class="eyebrow">EFFECT UI / DATASET CACHE</p>
    <h1>Data that remembers.</h1>
    <p>Switch stations. Refresh without losing the chart. Watch a late response arrive — and leave the newer snapshot untouched.</p>
    <p class="small-note">Illustrative observations fetched from static JSON. Latency and failed refreshes are simulated in the client.</p>
  </section>
  <DatasetLauncher client:load embeddedEditor={import.meta.env.PUBLIC_EMBED_EDITOR !== 'false'} downloadUrl={sitePath('/downloads/dataset-explorer.zip')} templateUrl={sitePath('/downloads/dataset-template.json')} />
  <section class="live-example" aria-label="Interactive dataset explorer">
    <DatasetExplorer client:load transport="fixtures" fixturesUrl={sitePath('/datasets/')} sources={datasetSources} />
    <noscript><p>Loading observations requires JavaScript.</p></noscript>
  </section>
  <section class="closing-callout">
    <h2>The chart composes. The data remembers.</h2>
    <p>Accessor-based geometry feeds independent axes, grid, line and point layers. Each station retains its last snapshot and rejects responses superseded by a newer request. The Model owns every control.</p>
  </section>
</Layout>
<style>
  .live-example { min-width: 0; }
</style>
